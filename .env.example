# Copy to .env.local. Every value below has a working default — the prototype
# runs with no configuration at all.

# Absolute origin the QR code should point at. Required in production; without
# it the app guesses from request headers, which is wrong behind most proxies.
# CAREPATH_PUBLIC_ORIGIN=https://carepath.hospital.org

# Front desk number for the tel: links. The defaults are reserved fictional
# numbers — set these before any real use.
# CAREPATH_FRONT_DESK_TEL=+15555550100
# CAREPATH_FRONT_DESK_DISPLAY=(555) 555-0100

# Lost-help provider. "rules" (default) is deterministic and needs no network.
# "claude" additionally requires ANTHROPIC_API_KEY and a hospital-approved,
# zero-retention endpoint. Both are wrapped by the same guard and post-filter.
# CAREPATH_ASSIST_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CAREPATH_ASSIST_MODEL=claude-opus-5
